@model TaskFlow.Web.ViewModels.Projects.DeleteProjectViewModel

@{
    ViewData["Title"] = "Delete Project";
}

<div class="form-page">

    <div class="form-page-header">

        <div>
            <div class="workspace-eyebrow">
                Projects
            </div>

            <h1 class="form-page-title">
                Delete project
            </h1>

            <p class="form-page-description">
                Review the consequences before continuing.
            </p>
        </div>

    </div>


    <div class="danger-card">

        <div class="danger-header">

            <h2 class="danger-title">
                Delete this project?
            </h2>

            <p class="danger-description">
                Tasks belonging to this project will also be permanently deleted.
            </p>

        </div>


        <div class="danger-content">

            <div class="danger-summary">

                <div class="danger-summary-title">
                    @Model.Name
                </div>

            </div>


            <form asp-controller="Projects"
                  asp-action="Delete"
                  method="post">

                <input asp-for="Id"
                       type="hidden" />

                <div class="danger-actions">

                    <a asp-controller="Projects"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Delete project and tasks
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>