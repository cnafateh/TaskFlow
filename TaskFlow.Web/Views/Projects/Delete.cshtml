@model TaskFlow.Web.ViewModels.Projects.DeleteProjectViewModel

@{
    ViewData["Title"] = "Delete Project";
}

<h1>Delete Project</h1>

<h3>
    Are you sure you want to delete this project?
</h3>

<div>
    <p>
        <strong>Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Description:</strong>
        @Model.Description
    </p>
</div>

<form asp-controller="Projects"
      asp-action="Delete"
      method="post">

    <input asp-for="Id"
           type="hidden" />

    <button type="submit"
            class="btn btn-danger">
        Delete
    </button>

    <a asp-controller="Projects"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>