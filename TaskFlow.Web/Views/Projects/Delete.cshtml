@model TaskFlow.Web.ViewModels.Projects.DeleteProjectViewModel

<h1>Delete Project</h1>

<h3>Are you sure you want to delete this project?</h3>

<p>
    <strong>Name:</strong>
    @Model.Name
</p>

<p>
    <strong>Description:</strong>
    @Model.Description
</p>

<form asp-controller="Projects"
      asp-action="Delete"
      method="post">

    <input asp-for="Id" type="hidden" />

    <button type="submit">
        Delete Project
    </button>
</form>