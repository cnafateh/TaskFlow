@model TaskFlow.Web.ViewModels.Projects.DeleteProjectViewModel

@{
    ViewData["Title"] = "Delete Project";
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            Delete Project
        </h1>
    </div>

</div>

<div class="app-card">

    <div class="alert alert-danger">

        <strong>Warning:</strong>
        deleting this project will also delete all tasks
        assigned to it.

    </div>

    <h2 class="h5">
        @Model.Name
    </h2>

    <p class="text-muted">
        @Model.Description
    </p>

    <form asp-controller="Projects"
          asp-action="Delete"
          method="post">

        <input asp-for="Id"
               type="hidden" />

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-danger">
                Delete Project
            </button>

            <a asp-controller="Projects"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>