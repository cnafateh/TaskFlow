@model IEnumerable<TaskFlow.Web.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="workspace-header">

    <div>

        <div class="workspace-eyebrow">
            Workspace
        </div>

        <h1 class="workspace-title">
            Categories
        </h1>

        <p class="workspace-description">
            Add another layer of organization to your tasks.
        </p>

    </div>


    <div class="workspace-actions">

        <a asp-controller="Categories"
           asp-action="Create"
           class="btn btn-primary">

            New category

        </a>

    </div>

</div>


@if (!Model.Any())
{
    <div class="empty-state">

        <div class="workspace-link-icon mx-auto">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8">

                <path d="M4 9h16"></path>
                <path d="M4 15h16"></path>
                <path d="M10 3L8 21"></path>
                <path d="M16 3l-2 18"></path>

            </svg>

        </div>

        <h3>
            No categories yet
        </h3>

        <p class="text-muted mb-3">
            Create categories to organize tasks more precisely.
        </p>

        <a asp-controller="Categories"
           asp-action="Create"
           class="btn btn-primary">

            Create category

        </a>

    </div>
}
else
{
    <div class="category-list">

        @foreach (var category in Model)
        {
            <div class="category-card">

                <div class="category-content">

                    <div class="category-name">
                        @category.Name
                    </div>

                    <div class="category-label">
                        Task category
                    </div>

                </div>


                <div class="category-actions">

                    <a asp-controller="Categories"
                       asp-action="Edit"
                       asp-route-id="@category.Id"
                       class="task-action-button">

                        Edit

                    </a>

                    <a asp-controller="Categories"
                       asp-action="Delete"
                       asp-route-id="@category.Id"
                       class="task-action-button task-action-danger">

                        Delete

                    </a>

                </div>

            </div>
        }

    </div>
}