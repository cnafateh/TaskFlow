@model TaskFlow.Web.ViewModels.Projects.EditProjectViewModel

@{
    ViewData["Title"] = "Edit Project";
}

<div class="form-page">

    <div class="form-page-header">

        <div>

            <div class="workspace-eyebrow">
                Projects
            </div>

            <h1 class="form-page-title">
                Edit project
            </h1>

            <p class="form-page-description">
                Update the project's name or description.
            </p>

        </div>


        <a asp-controller="Projects"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Back to projects

        </a>

    </div>


    <form asp-controller="Projects"
          asp-action="Edit"
          method="post">

        <input asp-for="Id"
               type="hidden" />


        <div class="form-card">

            <div class="form-section">

                <div class="form-section-header">

                    <h2 class="form-section-title">
                        Project information
                    </h2>

                </div>


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="form-grid">

                    <div class="form-field-full">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="form-field-full">

                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <div class="form-actions">

                <a asp-controller="Projects"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    Save changes

                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}