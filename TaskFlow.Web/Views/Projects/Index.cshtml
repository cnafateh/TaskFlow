@model IEnumerable<TaskFlow.Web.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="workspace-header">

    <div>

        <div class="workspace-eyebrow">
            Workspace
        </div>

        <h1 class="workspace-title">
            Projects
        </h1>

        <p class="workspace-description">
            Organize related tasks into focused areas of work.
        </p>

    </div>


    <div class="workspace-actions">

        <a asp-controller="Projects"
           asp-action="Create"
           class="btn btn-primary">

            New project

        </a>

    </div>

</div>


@if (!Model.Any())
{
    <div class="empty-state">

        <div class="workspace-link-icon mx-auto">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8">

                <path d="M3 7h7l2 2h9v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z">
                </path>

                <path d="M3 7V5a2 2 0 0 1 2-2h5l2 2">
                </path>

            </svg>

        </div>

        <h3>
            No projects yet
        </h3>

        <p class="text-muted mb-3">
            Create your first project to start organizing tasks.
        </p>

        <a asp-controller="Projects"
           asp-action="Create"
           class="btn btn-primary">

            Create project

        </a>

    </div>
}
else
{
    <div class="collection-grid">

        @foreach (var project in Model)
        {
            <div class="collection-card">

                <div class="collection-card-header">

                    <div class="collection-icon">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">

                            <path d="M3 7h7l2 2h9v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z">
                            </path>

                            <path d="M3 7V5a2 2 0 0 1 2-2h5l2 2">
                            </path>

                        </svg>

                    </div>

                </div>


                <div class="collection-title">
                    @project.Name
                </div>


                @if (!string.IsNullOrWhiteSpace(
                        project.Description))
                {
                    <div class="collection-description">
                        @project.Description
                    </div>
                }
                else
                {
                    <div class="collection-description">
                        No description added.
                    </div>
                }


                <div class="collection-meta">
                    Created @project.CreatedAt.ToString("MMM dd, yyyy")
                </div>


                <div class="collection-footer">

                    <span class="tf-pill tf-pill-neutral">
                        Project
                    </span>


                    <div class="collection-actions">

                        <a asp-controller="Projects"
                           asp-action="Edit"
                           asp-route-id="@project.Id"
                           class="task-action-button">

                            Edit

                        </a>

                        <a asp-controller="Projects"
                           asp-action="Delete"
                           asp-route-id="@project.Id"
                           class="task-action-button task-action-danger">

                            Delete

                        </a>

                    </div>

                </div>

            </div>
        }

    </div>
}