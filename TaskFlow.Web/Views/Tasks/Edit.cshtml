@model TaskFlow.Web.ViewModels.Tasks.EditTaskViewModel

@{
    ViewData["Title"] = "Edit Task";
}

<div class="form-page">

    <div class="form-page-header">

        <div>

            <div class="workspace-eyebrow">
                Tasks
            </div>

            <h1 class="form-page-title">
                Edit task
            </h1>

            <p class="form-page-description">
                Update the task details, organization or progress.
            </p>

        </div>


        <a asp-controller="Tasks"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Back to tasks

        </a>

    </div>


    <form asp-controller="Tasks"
          asp-action="Edit"
          method="post">

        <input asp-for="Id"
               type="hidden" />


        <div class="form-card">


            <div class="form-section">

                <div class="form-section-header">

                    <h2 class="form-section-title">
                        Task information
                    </h2>

                    <p class="form-section-description">
                        Update the primary task details.
                    </p>

                </div>


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="form-grid">


                    <div class="form-field-full">

                        <label asp-for="Title"
                               class="form-label">
                        </label>

                        <input asp-for="Title"
                               class="form-control" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="form-field-full">

                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <div class="form-section">

                <div class="form-section-header">

                    <h2 class="form-section-title">
                        Organization & progress
                    </h2>

                    <p class="form-section-description">
                        Adjust where the task belongs and its current state.
                    </p>

                </div>


                <div class="form-grid">


                    <div>

                        <label asp-for="ProjectId"
                               class="form-label">

                            Project

                        </label>

                        <select asp-for="ProjectId"
                                asp-items="Model.Projects"
                                class="form-select">
                        </select>

                        <span asp-validation-for="ProjectId"
                              class="text-danger">
                        </span>

                    </div>


                    <div>

                        <label asp-for="CategoryId"
                               class="form-label">

                            Category

                        </label>

                        <select asp-for="CategoryId"
                                asp-items="Model.Categories"
                                class="form-select">
                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>

                    </div>


                    <div>

                        <label asp-for="Priority"
                               class="form-label">
                        </label>

                        <select asp-for="Priority"
                                asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskPriority>()"
                                class="form-select">
                        </select>

                    </div>


                    <div>

                        <label asp-for="Status"
                               class="form-label">
                        </label>

                        <select asp-for="Status"
                                asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskStatus>()"
                                class="form-select">
                        </select>

                    </div>


                    <div>

                        <label asp-for="DueDate"
                               class="form-label">

                            Due date

                        </label>

                        <input asp-for="DueDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DueDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>


            <div class="form-actions">

                <a asp-controller="Tasks"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    Save changes

                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}