@model TaskFlow.Web.ViewModels.Tasks.DeleteTaskViewModel

@{
    ViewData["Title"] = "Delete Task";
}

<div class="page-header">

    <div>
        <h1 class="page-title">
            Delete Task
        </h1>
    </div>

</div>

<div class="app-card">

    <div class="alert alert-warning">

        Are you sure you want to delete
        <strong>@Model.Title</strong>?

    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <p class="text-muted">
            @Model.Description
        </p>
    }

    <form asp-controller="Tasks"
          asp-action="Delete"
          method="post">

        <input asp-for="Id"
               type="hidden" />

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-danger">
                Delete Task
            </button>

            <a asp-controller="Tasks"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>