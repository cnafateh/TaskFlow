@model TaskFlow.Web.ViewModels.Tasks.DeleteTaskViewModel

@{
    ViewData["Title"] = "Delete Task";
}

<div class="form-page">

    <div class="form-page-header">

        <div>

            <div class="workspace-eyebrow">
                Tasks
            </div>

            <h1 class="form-page-title">
                Delete task
            </h1>

            <p class="form-page-description">
                Confirm the permanent removal of this task.
            </p>

        </div>

    </div>


    <div class="danger-card">

        <div class="danger-header">

            <h2 class="danger-title">
                Delete this task?
            </h2>

            <p class="danger-description">
                This action cannot be undone.
            </p>

        </div>


        <div class="danger-content">

            <div class="danger-summary">

                <div class="danger-summary-title">
                    @Model.Title
                </div>

            </div>


            <form asp-controller="Tasks"
                  asp-action="Delete"
                  method="post">

                <input asp-for="Id"
                       type="hidden" />

                <div class="danger-actions">

                    <a asp-controller="Tasks"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Delete permanently
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>