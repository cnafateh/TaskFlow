@model TaskFlow.Web.Models.TaskItem

<h1>Delete Task</h1>

<h3>Are you sure you want to delete this task?</h3>

<p>
    <strong>Title:</strong>
    @Model.Title
</p>

<p>
    <strong>Description:</strong>
    @Model.Description
</p>

<form asp-controller="Tasks"
      asp-action="Delete"
      method="post">

    <input asp-for="Id" type="hidden" />

    <button type="submit">
        Delete Task
    </button>
</form>