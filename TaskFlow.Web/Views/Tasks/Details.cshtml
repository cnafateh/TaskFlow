@model TaskFlow.Web.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
}

<h1>Task Details</h1>

<h2>@Model.Title</h2>

<p>@Model.Description</p>

<p>Priority: @Model.Priority</p>

<p>Status: @Model.Status</p>

<p>Due Date: @Model.DueDate.ToShortDateString()</p>

<p>
    Project:
    @(Model.Project?.Name)
</p>
<p>
    category:
    @(Model.Category?.Name)
</p>

<p>
    <strong>Created:</strong>
    @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
</p>

@if (Model.UpdatedAt.HasValue)
{
    <p>
        <strong>Last Updated:</strong>
        @Model.UpdatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
    </p>
}

<a asp-controller="Tasks"
   asp-action="Index">
    Back to Tasks
</a>