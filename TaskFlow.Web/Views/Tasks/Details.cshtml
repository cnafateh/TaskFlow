@model TaskFlow.Web.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            @Model.Title
        </h1>

        <p class="page-subtitle">
            Task details
        </p>

    </div>

    <div class="d-flex gap-2">

        <a asp-controller="Tasks"
           asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Edit
        </a>

        <a asp-controller="Tasks"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back
        </a>

    </div>

</div>

<div class="app-card">

    <div class="details-row">

        <div class="meta-label">
            Description
        </div>

        <div>
            @Model.Description
        </div>

    </div>

    <div class="details-row">

        <div class="meta-label">
            Project
        </div>

        <div>
            @Model.Project?.Name
        </div>

    </div>

    <div class="details-row">

        <div class="meta-label">
            Category
        </div>

        <div>
            @Model.Category?.Name
        </div>

    </div>

    <div class="details-row">

        <div class="meta-label">
            Priority
        </div>

        <div>
            @Model.Priority
        </div>

    </div>

    <div class="details-row">

        <div class="meta-label">
            Status
        </div>

        <div>
            @Model.Status
        </div>

    </div>

    <div class="details-row">

        <div class="meta-label">
            Due Date
        </div>

        <div>
            @Model.DueDate.ToShortDateString()
        </div>

    </div>

    <div class="details-row">

        <div class="meta-label">
            Created
        </div>

        <div>
            @Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </div>

    </div>

    @if (Model.UpdatedAt.HasValue)
    {
        <div class="details-row">

            <div class="meta-label">
                Last Updated
            </div>

            <div>
                @Model.UpdatedAt.Value
                .ToLocalTime()
                .ToString("yyyy-MM-dd HH:mm")
            </div>

        </div>
    }

</div>