@model TaskFlow.Web.Models.TaskItem

@{
    ViewData["Title"] = "Task Details";
}

<div class="form-page">


    <div class="form-page-header">

        <div>

            <div class="workspace-eyebrow">
                Tasks
            </div>

            <h1 class="form-page-title">
                Task details
            </h1>

            <p class="form-page-description">
                Review the complete information for this task.
            </p>

        </div>


        <a asp-controller="Tasks"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Back to tasks

        </a>

    </div>


    <div class="details-card">


        <div class="details-header">

            <div>

                <div class="d-flex
                    align-items-center
                    gap-2
                    flex-wrap
                    mb-2">

                    @if (Model.Status ==
                        TaskFlow.Web.Models.Enums.TaskStatus.Done)
                    {
                        <span class="tf-pill tf-pill-success">
                            Done
                        </span>
                    }
                    else if (Model.Status ==
                             TaskFlow.Web.Models.Enums.TaskStatus.InProgress)
                    {
                        <span class="tf-pill tf-pill-primary">
                            In progress
                        </span>
                    }
                    else
                    {
                        <span class="tf-pill tf-pill-neutral">
                            Todo
                        </span>
                    }


                    @if (Model.Priority ==
                        TaskFlow.Web.Models.Enums.TaskPriority.High)
                    {
                        <span class="tf-pill tf-pill-danger">
                            High priority
                        </span>
                    }
                    else if (Model.Priority ==
                             TaskFlow.Web.Models.Enums.TaskPriority.Medium)
                    {
                        <span class="tf-pill tf-pill-warning">
                            Medium priority
                        </span>
                    }
                    else
                    {
                        <span class="tf-pill tf-pill-neutral">
                            Low priority
                        </span>
                    }

                </div>


                <h2 class="details-title">
                    @Model.Title
                </h2>


                @if (!string.IsNullOrWhiteSpace(
                        Model.Description))
                {
                    <p class="details-description">
                        @Model.Description
                    </p>
                }

            </div>

        </div>


        <div class="details-grid">


            <div class="details-item">

                <div class="details-label">
                    Project
                </div>

                <div class="details-value">
                    @Model.Project?.Name
                </div>

            </div>


            <div class="details-item">

                <div class="details-label">
                    Category
                </div>

                <div class="details-value">
                    @Model.Category?.Name
                </div>

            </div>


            <div class="details-item">

                <div class="details-label">
                    Due date
                </div>

                <div class="details-value">
                    @Model.DueDate.ToString("MMM dd, yyyy")
                </div>

            </div>


            <div class="details-item">

                <div class="details-label">
                    Created
                </div>

                <div class="details-value">
                    @Model.CreatedAt.ToString("MMM dd, yyyy")
                </div>

            </div>


            <div class="details-item">

                <div class="details-label">
                    Last updated
                </div>

                <div class="details-value">

                    @if (Model.UpdatedAt.HasValue)
                    {
                        @Model.UpdatedAt.Value.ToString("MMM dd, yyyy")
                    }
                    else
                    {
                        <span class="text-muted">
                            Not updated yet
                        </span>
                    }

                </div>

            </div>


        </div>


        <div class="details-actions">

            <a asp-controller="Tasks"
               asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">

                Delete

            </a>

            <a asp-controller="Tasks"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">

                Edit task

            </a>

        </div>

    </div>

</div>