@model TaskFlow.Web.ViewModels.Tasks.TaskIndexViewModel

@{
    ViewData["Title"] = "Tasks";
}


<div class="workspace-header">

    <div>

        <div class="workspace-eyebrow">
            Workspace
        </div>

        <h1 class="workspace-title">
            Tasks
        </h1>

        <p class="workspace-description">
            Plan your work, track progress and keep priorities visible.
        </p>

    </div>


    <div class="workspace-actions">

        <a asp-controller="Tasks"
           asp-action="Create"
           class="btn btn-primary">

            New task

        </a>

    </div>

</div>


<partial name="_TaskFilters"
         model="Model" />


<div class="task-page-toolbar">

    <div class="task-result-count">

        @Model.TotalCount
        task@(Model.TotalCount == 1 ? "" : "s")

    </div>

</div>


@if (Model.Tasks.Count == 0)
{
    <div class="empty-state">

        <div class="workspace-link-icon mx-auto">

            <svg viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="1.8">

                <path d="M9 11l3 3L22 4"></path>

                <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

            </svg>

        </div>

        <h3>
            No tasks found
        </h3>

        <p class="text-muted mb-3">
            Create a task or adjust the current filters.
        </p>

        <a asp-controller="Tasks"
           asp-action="Create"
           class="btn btn-primary">

            Create task

        </a>

    </div>
}
else
{
    <div class="app-card table-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>
                        <th>Task</th>
                        <th>Project</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Due</th>
                        <th class="text-end">
                            Actions
                        </th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var task in Model.Tasks)
                    {
                        <tr>

                            <td>

                                <div class="task-table-title">
                                    @task.Title
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                        task.Description))
                                {
                                    <div class="task-table-description">
                                        @task.Description
                                    </div>
                                }

                            </td>


                            <td>

                                <div class="task-meta-stack">

                                    <span class="task-project-name">
                                        @task.Project?.Name
                                    </span>

                                    <span class="task-category-name">
                                        @task.Category?.Name
                                    </span>

                                </div>

                            </td>


                            <td>

                                @if (task.Priority ==
                                    TaskFlow.Web.Models.Enums.TaskPriority.High)
                                {
                                    <span class="tf-pill tf-pill-danger">
                                        High
                                    </span>
                                }
                                else if (task.Priority ==
                                         TaskFlow.Web.Models.Enums.TaskPriority.Medium)
                                {
                                    <span class="tf-pill tf-pill-warning">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="tf-pill tf-pill-neutral">
                                        Low
                                    </span>
                                }

                            </td>


                            <td>

                                @if (task.Status ==
                                    TaskFlow.Web.Models.Enums.TaskStatus.Done)
                                {
                                    <span class="tf-pill tf-pill-success">
                                        Done
                                    </span>
                                }
                                else if (task.Status ==
                                         TaskFlow.Web.Models.Enums.TaskStatus.InProgress)
                                {
                                    <span class="tf-pill tf-pill-primary">
                                        In progress
                                    </span>
                                }
                                else
                                {
                                    <span class="tf-pill tf-pill-neutral">
                                        Todo
                                    </span>
                                }

                            </td>


                            <td>

                                <span class="text-muted small">
                                    @task.DueDate.ToString("MMM dd, yyyy")
                                </span>

                            </td>


                            <td>

                                <div class="task-action-group">

                                    <a asp-controller="Tasks"
                                       asp-action="Details"
                                       asp-route-id="@task.Id"
                                       class="task-action-button">

                                        View

                                    </a>

                                    <a asp-controller="Tasks"
                                       asp-action="Edit"
                                       asp-route-id="@task.Id"
                                       class="task-action-button">

                                        Edit

                                    </a>

                                    <a asp-controller="Tasks"
                                       asp-action="Delete"
                                       asp-route-id="@task.Id"
                                       class="task-action-button task-action-danger">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Task pagination">

            <ul class="pagination justify-content-center">

                @if (Model.Page > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page - 1)"
                           asp-route-search="@Model.Search"
                           asp-route-projectId="@Model.ProjectId"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-priority="@Model.Priority"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@Model.SortBy">

                            ‹

                        </a>

                    </li>
                }


                @for (
                    int pageNumber = 1;
                    pageNumber <= Model.TotalPages;
                    pageNumber++)
                {
                    <li class="page-item
                        @(pageNumber == Model.Page
                            ? "active"
                            : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@pageNumber"
                           asp-route-search="@Model.Search"
                           asp-route-projectId="@Model.ProjectId"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-priority="@Model.Priority"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@Model.SortBy">

                            @pageNumber

                        </a>

                    </li>
                }


                @if (Model.Page < Model.TotalPages)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.Page + 1)"
                           asp-route-search="@Model.Search"
                           asp-route-projectId="@Model.ProjectId"
                           asp-route-categoryId="@Model.CategoryId"
                           asp-route-priority="@Model.Priority"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@Model.SortBy">

                            ›

                        </a>

                    </li>
                }

            </ul>

        </nav>
    }
}