@model List<TaskFlow.Web.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
}

<h1>Tasks</h1>

<a asp-controller="Tasks"
   asp-action="Create">
    Create New Task
</a>

<hr />

@foreach (var task in Model)
{
    <div>
        <h3>@task.Title</h3>

        <p>@task.Description</p>

        <p>Due: @task.DueDate.ToShortDateString()</p>

        <p>Completed: @task.IsCompleted</p>

        <p>
            Project:
            @(task.Project?.Name)
        </p>

        <a asp-controller="Tasks"
           asp-action="Details"
           asp-route-id="@task.Id">
            Detail
        </a>
        <a asp-controller="Tasks"
           asp-action="Edit"
           asp-route-id="@task.Id">
            Edit
        </a>
        <a asp-controller="Tasks"
           asp-action="Delete"
           asp-route-id="@task.Id">
            Delete
        </a>
    </div>

    <hr />
}