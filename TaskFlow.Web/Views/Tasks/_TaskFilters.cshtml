@model TaskFlow.Web.ViewModels.Tasks.TaskIndexViewModel

<div class="app-card filter-card">

    <form asp-controller="Tasks"
          asp-action="Index"
          method="get">

        <div class="filter-grid">

            <div>
                <label asp-for="Search"
                       class="form-label">
                    Search
                </label>

                <input asp-for="Search"
                       class="form-control"
                       placeholder="Search title or description..." />
            </div>


            <div>
                <label asp-for="ProjectId"
                       class="form-label">
                    Project
                </label>

                <select asp-for="ProjectId"
                        asp-items="Model.Projects"
                        class="form-select">

                    <option value="">
                        All Projects
                    </option>

                </select>
            </div>


            <div>
                <label asp-for="CategoryId"
                       class="form-label">
                    Category
                </label>

                <select asp-for="CategoryId"
                        asp-items="Model.Categories"
                        class="form-select">

                    <option value="">
                        All Categories
                    </option>

                </select>
            </div>


            <div>
                <label asp-for="Priority"
                       class="form-label">
                    Priority
                </label>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskPriority>()"
                        class="form-select">

                    <option value="">
                        All Priorities
                    </option>

                </select>
            </div>


            <div>
                <label asp-for="Status"
                       class="form-label">
                    Status
                </label>

                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskStatus>()"
                        class="form-select">

                    <option value="">
                        All Statuses
                    </option>

                </select>
            </div>


            <div>
                <label asp-for="SortBy"
                       class="form-label">
                    Sort
                </label>

                <select asp-for="SortBy"
                        class="form-select">

                    <option value="">
                        Due Date - Earliest
                    </option>

                    <option value="dueDateDesc">
                        Due Date - Latest
                    </option>

                    <option value="title">
                        Title A-Z
                    </option>

                    <option value="titleDesc">
                        Title Z-A
                    </option>

                    <option value="createdAt">
                        Created - Oldest
                    </option>

                    <option value="createdAtDesc">
                        Created - Newest
                    </option>

                </select>
            </div>

        </div>


        <div class="d-flex gap-2 mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Apply Filters
            </button>

            <a asp-controller="Tasks"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Reset
            </a>

        </div>

    </form>

</div>