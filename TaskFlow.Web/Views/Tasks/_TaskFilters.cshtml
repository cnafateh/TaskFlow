@model TaskFlow.Web.ViewModels.Tasks.TaskIndexViewModel

<div class="task-filter-panel">

    <form asp-controller="Tasks"
          asp-action="Index"
          method="get">

        <div class="task-filter-grid">


            <div>

                <label asp-for="Search"
                       class="form-label">
                    Search
                </label>

                <div class="admin-search-wrap">

                    <svg class="admin-search-icon"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="11"
                                cy="11"
                                r="7">
                        </circle>

                        <path d="m20 20-3.5-3.5">
                        </path>

                    </svg>

                    <input asp-for="Search"
                           class="form-control admin-search-input"
                           placeholder="Search tasks..." />

                </div>

            </div>


            <div>

                <label asp-for="ProjectId"
                       class="form-label">

                    Project

                </label>

                <select asp-for="ProjectId"
                        asp-items="Model.Projects"
                        class="form-select">

                    <option value="">
                        All projects
                    </option>

                </select>

            </div>


            <div>

                <label asp-for="CategoryId"
                       class="form-label">

                    Category

                </label>

                <select asp-for="CategoryId"
                        asp-items="Model.Categories"
                        class="form-select">

                    <option value="">
                        All categories
                    </option>

                </select>

            </div>


            <div>

                <label asp-for="Status"
                       class="form-label">

                    Status

                </label>

                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskStatus>()"
                        class="form-select">

                    <option value="">
                        All statuses
                    </option>

                </select>

            </div>


            <div>

                <label asp-for="Priority"
                       class="form-label">

                    Priority

                </label>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskPriority>()"
                        class="form-select">

                    <option value="">
                        All priorities
                    </option>

                </select>

            </div>


            <div>

                <label asp-for="SortBy"
                       class="form-label">

                    Sort

                </label>

                <select asp-for="SortBy"
                        class="form-select">

                    <option value="">
                        Default
                    </option>

                    <option value="title">
                        Title A–Z
                    </option>

                    <option value="titleDesc">
                        Title Z–A
                    </option>

                    <option value="dueDate">
                        Due date
                    </option>

                    <option value="dueDateDesc">
                        Due date descending
                    </option>

                </select>

            </div>


            <div class="task-filter-actions">

                <button type="submit"
                        class="btn btn-primary">

                    Apply

                </button>

                <a asp-controller="Tasks"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    Reset

                </a>

            </div>

        </div>

    </form>

</div>