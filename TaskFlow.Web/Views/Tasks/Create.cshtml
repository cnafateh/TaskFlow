@model TaskFlow.Web.ViewModels.Tasks.CreateTaskViewModel

@{
    ViewData["Title"] = "Create Task";
}

<h1>Create New Task</h1>

<form asp-controller="Tasks"
      asp-action="Create"
      method="post">

    <div asp-validation-summary="ModelOnly"></div>


    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <div>
        <label asp-for="Priority"></label>

        <select asp-for="Priority"
                asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskPriority>()">
        </select>

        <span asp-validation-for="Priority"></span>
    </div>

    <div>
        <label asp-for="DueDate"></label>
        <input asp-for="DueDate" />
        <span asp-validation-for="DueDate"></span>
    </div>

    <div>
        <label asp-for="ProjectId"></label>

        <select asp-for="ProjectId"
                asp-items="Model.Projects">
            <option value="">Select a project</option>
        </select>

        <span asp-validation-for="ProjectId"></span>
    </div>

    <div>
        <label asp-for="CategoryId"></label>

        <select asp-for="CategoryId"
                asp-items="Model.Categories">
            <option value="">Select a category</option>
        </select>

        <span asp-validation-for="CategoryId"></span>
    </div>

    <button type="submit">
        Create
    </button>

</form>