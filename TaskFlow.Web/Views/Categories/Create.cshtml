@model TaskFlow.Web.ViewModels.Categories.CreateCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<div class="page-header">

    <div>

        <h1 class="page-title">
            Create Category
        </h1>

        <p class="page-subtitle">
            Add a category for organizing tasks.
        </p>

    </div>

</div>

<div class="app-card">

    <form asp-controller="Categories"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">

            <label asp-for="Name"
                   class="form-label">
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>

        </div>

        <div class="d-flex gap-2">

            <button type="submit"
                    class="btn btn-primary">
                Create Category
            </button>

            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}