@model TaskFlow.Web.Models.Category

@{
    ViewData["Title"] = "New Category";
}

<div class="form-page">

    <div class="form-page-header">

        <div>

            <div class="workspace-eyebrow">
                Categories
            </div>

            <h1 class="form-page-title">
                Create category
            </h1>

            <p class="form-page-description">
                Add a category for organizing your tasks.
            </p>

        </div>


        <a asp-controller="Categories"
           asp-action="Index"
           class="btn btn-outline-secondary">

            Back to categories

        </a>

    </div>


    <form asp-controller="Categories"
          asp-action="Create"
          method="post">

        <div class="form-card">

            <div class="form-section">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="form-grid">

                    <div class="form-field-full">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Category name" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                        <div class="form-help">
                            Use a short name that will be easy to recognize when creating tasks.
                        </div>

                    </div>

                </div>

            </div>


            <div class="form-actions">

                <a asp-controller="Categories"
                   asp-action="Index"
                   class="btn btn-outline-secondary">

                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    Create category

                </button>

            </div>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}