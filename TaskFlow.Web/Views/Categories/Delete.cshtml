@model TaskFlow.Web.ViewModels.Categories.DeleteCategoryViewModel

@{
    ViewData["Title"] = "Delete Category";
}

<div class="form-page">

    <div class="form-page-header">

        <div>

            <div class="workspace-eyebrow">
                Categories
            </div>

            <h1 class="form-page-title">
                Delete category
            </h1>

            <p class="form-page-description">
                Remove an unused category from your workspace.
            </p>

        </div>

    </div>


    <div class="danger-card">

        <div class="danger-header">

            <h2 class="danger-title">
                Delete this category?
            </h2>

            <p class="danger-description">
                Categories currently assigned to tasks cannot be deleted.
            </p>

        </div>


        <div class="danger-content">

            <div class="danger-summary">

                <div class="danger-summary-title">
                    @Model.Name
                </div>

            </div>


            <form asp-controller="Categories"
                  asp-action="Delete"
                  method="post">

                <input asp-for="Id"
                       type="hidden" />


                <div class="danger-actions">

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-danger">

                        Delete category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>