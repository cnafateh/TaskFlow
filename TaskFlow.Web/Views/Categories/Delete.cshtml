@model TaskFlow.Web.ViewModels.Categories.DeleteCategoryViewModel

<h1>Delete Category</h1>

<h3>Are you sure you want to delete this category?</h3>

<p>
    <strong>Name:</strong>
    @Model.Name
</p>

<form asp-controller="Categories"
      asp-action="Delete"
      method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger">
    </div>

    <input asp-for="Id" type="hidden" />

    <button type="submit">
        Delete Category
    </button>
</form>