@model List<TaskFlow.Web.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<a asp-controller="Categories"
   asp-action="Create">
    Create New Category
</a>

<hr />

@foreach (var category in Model)
{
    <div>
        <h3>@category.Name</h3>

        <a asp-controller="Categories"
           asp-action="Edit"
           asp-route-id="@category.Id">
            Edit
        </a>
        <a asp-controller="Categories"
           asp-action="Delete"
           asp-route-id="@category.Id">
            Delete
        </a>
    </div>

    <hr />
}