@model TaskFlow.Web.ViewModels.Tasks.TaskSummaryViewModel

<div class="user-stat-grid">

    <div class="user-stat-card">

        <div class="user-stat-content">

            <div class="user-stat-label">
                Total tasks
            </div>

            <div class="user-stat-value">
                @Model.TotalTasks
            </div>

            <div class="user-stat-meta">
                Tasks in your workspace
            </div>

        </div>

    </div>


    <div class="user-stat-card">

        <div class="user-stat-content">

            <div class="user-stat-label">
                In progress
            </div>

            <div class="user-stat-value">
                @Model.InProgressTasks
            </div>

            <div class="user-stat-meta">
                Currently being worked on
            </div>

        </div>

    </div>


    <div class="user-stat-card">

        <div class="user-stat-content">

            <div class="user-stat-label">
                Completed
            </div>

            <div class="user-stat-value">
                @Model.CompletedTasks
            </div>

            <div class="user-stat-meta">
                Finished tasks
            </div>

        </div>

    </div>

</div>