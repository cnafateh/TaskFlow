@{
    string? currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TaskFlow</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    TaskFlow
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active fw-semibold" : "")"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Tasks" ? "active fw-semibold" : "")"
                                   asp-controller="Tasks"
                                   asp-action="Index">
                                    Tasks
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Projects" ? "active fw-semibold" : "")"
                                   asp-controller="Projects"
                                   asp-action="Index">
                                    Projects
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Categories" ? "active fw-semibold" : "")"
                                   asp-controller="Categories"
                                   asp-action="Index">
                                    Categories
                                </a>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>
    </header>

    <div class="container app-container">

        <main role="main">
            @RenderBody()
        </main>

    </div>

    <footer class="app-footer">

        <div class="container">
            <span>TaskFlow &copy; 2026</span>
        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>