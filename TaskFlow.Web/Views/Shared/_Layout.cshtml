@{
    string? currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] · TaskFlow</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

    <header class="tf-header">

        <nav class="navbar navbar-expand-lg">

            <div class="container">

                <a class="tf-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="tf-brand-mark">
                        TF
                    </span>

                    <span class="tf-brand-name">
                        TaskFlow
                    </span>

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav tf-main-nav me-auto">

                            <li class="nav-item">

                                <a class="nav-link
                                    @(currentController == "Home"
                                       ? "active"
                                       : "")"
                                   asp-controller="Home"
                                   asp-action="Index">

                                    Overview

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link
                                    @(currentController == "Tasks"
                                       ? "active"
                                       : "")"
                                   asp-controller="Tasks"
                                   asp-action="Index">

                                    Tasks

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link
                                    @(currentController == "Projects"
                                       ? "active"
                                       : "")"
                                   asp-controller="Projects"
                                   asp-action="Index">

                                    Projects

                                </a>

                            </li>


                            <li class="nav-item">

                                <a class="nav-link
                                    @(currentController == "Categories"
                                       ? "active"
                                       : "")"
                                   asp-controller="Categories"
                                   asp-action="Index">

                                    Categories

                                </a>

                            </li>

                        </ul>
                    }
                    else
                    {
                        <div class="me-auto"></div>
                    }


                    <partial name="_LoginPartial" />

                </div>

            </div>

        </nav>

    </header>


    <div class="app-container container">

        <partial name="_FlashMessages" />


        <main role="main"
              class="app-main">

            @RenderBody()

        </main>

    </div>


    <footer class="tf-footer">

        <div class="container">

            <div class="tf-footer-inner">

                <div>
                    TaskFlow
                </div>

                <div>
                    ASP.NET Core MVC
                </div>

            </div>

        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>