@{
    ViewData["Title"] = "Home";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="page-header">

        <div>
            <h1 class="page-title">
                Welcome to TaskFlow
            </h1>

            <p class="page-subtitle">
                Manage your projects, tasks and categories.
            </p>
        </div>

        <a asp-controller="Tasks"
           asp-action="Create"
           class="btn btn-primary">
            New Task
        </a>

    </div>

    <vc:task-summary></vc:task-summary>

    <div class="row g-4">

        <div class="col-md-4">

            <a asp-controller="Tasks"
               asp-action="Index"
               class="text-dark">

                <div class="app-card quick-link-card">

                    <h3 class="h5">
                        Tasks
                    </h3>

                    <p class="text-muted mb-0">
                        Search, filter and manage your tasks.
                    </p>

                </div>

            </a>

        </div>

        <div class="col-md-4">

            <a asp-controller="Projects"
               asp-action="Index"
               class="text-dark">

                <div class="app-card quick-link-card">

                    <h3 class="h5">
                        Projects
                    </h3>

                    <p class="text-muted mb-0">
                        Organize your tasks into projects.
                    </p>

                </div>

            </a>

        </div>

        <div class="col-md-4">

            <a asp-controller="Categories"
               asp-action="Index"
               class="text-dark">

                <div class="app-card quick-link-card">

                    <h3 class="h5">
                        Categories
                    </h3>

                    <p class="text-muted mb-0">
                        Keep your tasks clearly categorized.
                    </p>

                </div>

            </a>

        </div>

    </div>
}
else
{
    <section class="hero">

        <div class="app-card hero-card mx-auto text-center">

            <h1 class="display-5 fw-bold mb-3">
                TaskFlow
            </h1>

            <p class="lead text-muted mb-4">
                A simple workspace for managing tasks,
                projects and priorities.
            </p>

            <div class="d-flex justify-content-center gap-2">

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-primary">
                    Login
                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-outline-primary">
                    Create Account
                </a>

            </div>

        </div>

    </section>
}