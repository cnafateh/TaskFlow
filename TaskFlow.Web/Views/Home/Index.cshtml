@{
    ViewData["Title"] = "Overview";
}

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="workspace-header">

        <div>

            <div class="workspace-eyebrow">
                Personal workspace
            </div>

            <h1 class="workspace-title">
                Your work, organized.
            </h1>

            <p class="workspace-description">
                Keep track of tasks, organize work into projects,
                and use categories to keep everything easy to find.
            </p>

        </div>


        <div class="workspace-actions">

            <a asp-controller="Tasks"
               asp-action="Create"
               class="btn btn-primary">

                New task

            </a>

            <a asp-controller="Projects"
               asp-action="Create"
               class="btn btn-outline-secondary">

                New project

            </a>

        </div>

    </div>


    <vc:task-summary></vc:task-summary>


    <div class="mb-3 mt-4">

        <div class="workspace-eyebrow">
            Workspace
        </div>

        <h2 class="admin-section-title">
            Manage your work
        </h2>

        <p class="admin-section-description">
            Jump into the area you want to work with.
        </p>

    </div>


    <div class="workspace-grid">


        <a asp-controller="Tasks"
           asp-action="Index"
           class="workspace-link">

            <div class="workspace-link-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M9 11l3 3L22 4"></path>

                    <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                </svg>

            </div>

            <div class="workspace-link-title">
                Tasks
            </div>

            <div class="workspace-link-text">
                Plan, prioritize and track your day-to-day work.
            </div>

            <div class="workspace-link-footer">
                Open tasks
                <span>→</span>
            </div>

        </a>


        <a asp-controller="Projects"
           asp-action="Index"
           class="workspace-link">

            <div class="workspace-link-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M3 7h7l2 2h9v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"></path>

                    <path d="M3 7V5a2 2 0 0 1 2-2h5l2 2"></path>

                </svg>

            </div>

            <div class="workspace-link-title">
                Projects
            </div>

            <div class="workspace-link-text">
                Group related tasks and keep larger pieces of work organized.
            </div>

            <div class="workspace-link-footer">
                Open projects
                <span>→</span>
            </div>

        </a>


        <a asp-controller="Categories"
           asp-action="Index"
           class="workspace-link">

            <div class="workspace-link-icon">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="1.8">

                    <path d="M4 9h16"></path>

                    <path d="M4 15h16"></path>

                    <path d="M10 3L8 21"></path>

                    <path d="M16 3l-2 18"></path>

                </svg>

            </div>

            <div class="workspace-link-title">
                Categories
            </div>

            <div class="workspace-link-text">
                Add another layer of organization across your tasks.
            </div>

            <div class="workspace-link-footer">
                Open categories
                <span>→</span>
            </div>

        </a>

    </div>
}
else
{
    <section class="hero">

        <div class="app-card hero-card text-center">

            <span class="tf-brand-mark mb-4">
                TF
            </span>

            <div class="workspace-eyebrow">
                TaskFlow
            </div>

            <h1 class="workspace-title">
                Keep work simple.
            </h1>

            <p class="workspace-description mx-auto">
                A focused workspace for organizing tasks,
                projects and priorities without unnecessary complexity.
            </p>

            <div class="d-flex
                justify-content-center
                flex-wrap
                gap-2
                mt-4">

                <a asp-area="Identity"
                   asp-page="/Account/Register"
                   class="btn btn-primary">

                    Create account

                </a>

                <a asp-area="Identity"
                   asp-page="/Account/Login"
                   class="btn btn-outline-secondary">

                    Sign in

                </a>

            </div>

        </div>

    </section>
}