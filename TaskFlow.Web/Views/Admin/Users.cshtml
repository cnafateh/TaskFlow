@model List<TaskFlow.Web.ViewModels.Admin.AdminUserViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="admin-page-header">

    <div class="admin-page-heading">

        <div class="d-flex align-items-center flex-wrap">

            <h1 class="admin-page-title">
                Users
            </h1>

            <span class="admin-count">
                @Model.Count
            </span>

        </div>

        <p class="admin-page-description">
            Manage registered accounts and application access.
        </p>

    </div>

</div>


<div class="admin-data-panel">

    <div class="admin-data-toolbar">

        <div class="admin-data-toolbar-left">

            <span class="admin-table-muted">
                Registered accounts
            </span>

        </div>

        <div class="admin-data-toolbar-right">

            <span class="admin-table-muted">
                @Model.Count total
            </span>

        </div>

    </div>


    @if (Model.Count == 0)
    {
        <div class="admin-empty">

            <div class="admin-empty-icon">
                U
            </div>

            <div class="admin-empty-title">
                No users found
            </div>

            <p class="admin-empty-text">
                Registered users will appear here.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="admin-table">

                <thead>

                    <tr>
                        <th>User</th>
                        <th>Role</th>
                        <th style="width: 290px;">
                            Access
                        </th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var user in Model)
                    {
                        string initial =
                            !string.IsNullOrWhiteSpace(user.Email)
                                ? user.Email[..1].ToUpper()
                                : "U";

                        <tr>

                            <td>

                                <div class="admin-user-cell">

                                    <div class="admin-user-avatar">
                                        @initial
                                    </div>

                                    <div>

                                        <div class="admin-user-email">
                                            @user.Email
                                        </div>

                                        <div class="admin-table-muted">
                                            Account
                                        </div>

                                    </div>

                                </div>

                            </td>


                            <td>

                                @if (user.Role == "Admin")
                                {
                                    <span class="admin-badge admin-badge-admin">
                                        Administrator
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-user">
                                        Member
                                    </span>
                                }

                            </td>


                            <td>

                                <form asp-controller="Admin"
                                      asp-action="ChangeRole"
                                      method="post"
                                      class="d-flex align-items-center gap-2">

                                    <input type="hidden"
                                           name="userId"
                                           value="@user.Id" />

                                    <select name="role"
                                            class="form-select form-select-sm">

                                        @if (user.Role == "User")
                                        {
                                            <option value="User"
                                                    selected>
                                                User
                                            </option>

                                            <option value="Admin">
                                                Admin
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="User">
                                                User
                                            </option>

                                            <option value="Admin"
                                                    selected>
                                                Admin
                                            </option>
                                        }

                                    </select>

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-primary text-nowrap">

                                        Update role

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>