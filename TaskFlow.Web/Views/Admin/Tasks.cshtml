@model TaskFlow.Web.ViewModels.Admin.AdminTaskIndexViewModel

@{
    ViewData["Title"] = "Tasks";
}

<div class="admin-page-header">

    <div class="admin-page-heading">

        <div class="d-flex align-items-center flex-wrap">

            <h1 class="admin-page-title">
                Tasks
            </h1>

            <span class="admin-count">
                @Model.TotalCount
            </span>

        </div>

        <p class="admin-page-description">
            Search, review and manage tasks across all accounts.
        </p>

    </div>

</div>


<div class="admin-filter-panel">

    <form asp-controller="Admin"
          asp-action="Tasks"
          method="get">

        <div class="admin-filter-grid">

            <div>

                <label class="form-label">
                    Search
                </label>

                <div class="admin-search-wrap">

                    <svg class="admin-search-icon"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">

                        <circle cx="11"
                                cy="11"
                                r="7">
                        </circle>

                        <path d="m20 20-3.5-3.5">
                        </path>

                    </svg>

                    <input asp-for="Search"
                           class="form-control admin-search-input"
                           placeholder="Task, project, category or user..." />

                </div>

            </div>


            <div>

                <label class="form-label">
                    Owner
                </label>

                <select asp-for="OwnerId"
                        class="form-select">

                    <option value="">
                        All users
                    </option>

                    @foreach (var owner in Model.Owners)
                    {
                        <option value="@owner.Id">
                            @owner.Email
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Status
                </label>

                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskStatus>()"
                        class="form-select">

                    <option value="">
                        All statuses
                    </option>

                </select>

            </div>


            <div>

                <label class="form-label">
                    Priority
                </label>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskPriority>()"
                        class="form-select">

                    <option value="">
                        All priorities
                    </option>

                </select>

            </div>


            <div>

                <label class="form-label">
                    Project
                </label>

                <select asp-for="ProjectId"
                        class="form-select">

                    <option value="">
                        All projects
                    </option>

                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id">
                            @project.Name
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Category
                </label>

                <select asp-for="CategoryId"
                        class="form-select">

                    <option value="">
                        All categories
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Sort
                </label>

                <select asp-for="SortBy"
                        class="form-select">

                    <option value="createdAtDesc">
                        Newest first
                    </option>

                    <option value="createdAt">
                        Oldest first
                    </option>

                    <option value="dueDate">
                        Due date
                    </option>

                    <option value="dueDateDesc">
                        Due date descending
                    </option>

                    <option value="title">
                        Title A–Z
                    </option>

                    <option value="titleDesc">
                        Title Z–A
                    </option>

                </select>

            </div>


            <div class="admin-filter-actions">

                <button type="submit"
                        class="btn btn-primary">

                    Apply filters

                </button>

                <a asp-action="Tasks"
                   class="btn btn-outline-secondary">

                    Reset

                </a>

            </div>

        </div>

    </form>

</div>


<div class="admin-data-panel">

    <div class="admin-data-toolbar">

        <div class="admin-data-toolbar-left">

            <span class="admin-selected-count"
                  id="taskSelectionCount">

                No tasks selected

            </span>

        </div>


        <div class="admin-data-toolbar-right">

            <form id="bulkTaskActionForm"
                  asp-controller="Admin"
                  asp-action="BulkTaskAction"
                  method="post"
                  class="d-flex align-items-center gap-2">

                <div id="bulkTaskSelectedIds">
                </div>

                <select id="bulkTaskActionSelect"
                        name="bulkAction"
                        class="form-select form-select-sm"
                        style="width: 180px;">

                    <option value="">
                        Select action
                    </option>

                    <option value="todo">
                        Mark as Todo
                    </option>

                    <option value="inProgress">
                        Mark as In Progress
                    </option>

                    <option value="done">
                        Mark as Done
                    </option>

                    <option value="delete">
                        Delete
                    </option>

                </select>

                <button id="bulkTaskActionButton"
                        type="submit"
                        class="btn btn-sm btn-outline-secondary"
                        disabled>

                    Apply

                </button>

            </form>

        </div>

    </div>


    @if (Model.Tasks.Count == 0)
    {
        <div class="admin-empty">

            <div class="admin-empty-icon">
                ✓
            </div>

            <div class="admin-empty-title">
                No tasks found
            </div>

            <p class="admin-empty-text">
                Try changing the current filters.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="admin-table">

                <thead>

                    <tr>

                        <th style="width: 44px;">

                            <input id="selectAllTasks"
                                   type="checkbox"
                                   class="form-check-input"
                                   aria-label="Select all tasks" />

                        </th>

                        <th>
                            Task
                        </th>

                        <th>
                            Owner
                        </th>

                        <th>
                            Project
                        </th>

                        <th>
                            Priority
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Due
                        </th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var task in Model.Tasks)
                    {
                        <tr>

                            <td>

                                <input type="checkbox"
                                       value="@task.Id"
                                       class="form-check-input task-checkbox"
                                       aria-label="Select @task.Title" />

                            </td>


                            <td>

                                <div class="admin-table-title">
                                    @task.Title
                                </div>

                                @if (!string.IsNullOrWhiteSpace(task.Description))
                                {
                                    <div class="admin-table-subtitle">
                                        @task.Description
                                    </div>
                                }

                                @if (task.Category != null)
                                {
                                    <div class="admin-table-muted mt-1">
                                        @task.Category.Name
                                    </div>
                                }

                            </td>


                            <td>

                                @{
                                    string ownerEmail =
                                        task.Project?.User?.Email
                                        ?? "?";

                                    string ownerInitial =
                                        ownerEmail.Length > 0
                                            ? ownerEmail[..1].ToUpper()
                                            : "?";
                                }

                                <div class="admin-user-cell">

                                    <div class="admin-user-avatar">
                                        @ownerInitial
                                    </div>

                                    <span class="admin-user-email">
                                        @ownerEmail
                                    </span>

                                </div>

                            </td>


                            <td>

                                <span class="admin-table-title">
                                    @task.Project?.Name
                                </span>

                            </td>


                            <td>

                                @if (task.Priority ==
                                    TaskFlow.Web.Models.Enums.TaskPriority.High)
                                {
                                    <span class="admin-badge admin-badge-danger">
                                        High
                                    </span>
                                }
                                else if (task.Priority ==
                                         TaskFlow.Web.Models.Enums.TaskPriority.Medium)
                                {
                                    <span class="admin-badge admin-badge-warning">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        Low
                                    </span>
                                }

                            </td>


                            <td>

                                @if (task.Status ==
                                    TaskFlow.Web.Models.Enums.TaskStatus.Done)
                                {
                                    <span class="admin-badge admin-badge-success">
                                        Done
                                    </span>
                                }
                                else if (task.Status ==
                                         TaskFlow.Web.Models.Enums.TaskStatus.InProgress)
                                {
                                    <span class="admin-badge admin-badge-primary">
                                        In progress
                                    </span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-neutral">
                                        Todo
                                    </span>
                                }

                            </td>


                            <td>

                                <span class="admin-table-muted">
                                    @task.DueDate.ToString("MMM dd, yyyy")
                                </span>

                            </td>


                            <td>

                                <div class="admin-table-actions">

                                    <form asp-controller="Admin"
                                          asp-action="DeleteTask"
                                          asp-route-id="@task.Id"
                                          method="post"
                                          onsubmit="return confirm('Delete this task?');">

                                        <button type="submit"
                                                class="admin-icon-button admin-icon-button-danger">

                                            Delete

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <div class="admin-table-footer">

            <div class="admin-pagination-info">

                Page @Model.Page of
                @(Model.TotalPages == 0 ? 1 : Model.TotalPages)

                · @Model.TotalCount total tasks

            </div>


            @if (Model.TotalPages > 1)
            {
                <ul class="pagination">

                    @if (Model.Page > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Tasks"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-ownerId="@Model.OwnerId"
                               asp-route-projectId="@Model.ProjectId"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-priority="@Model.Priority"
                               asp-route-status="@Model.Status"
                               asp-route-sortBy="@Model.SortBy">

                                ‹

                            </a>

                        </li>
                    }


                    @for (
                        int pageNumber = 1;
                        pageNumber <= Model.TotalPages;
                        pageNumber++)
                    {
                        <li class="page-item
                            @(pageNumber == Model.Page
                                ? "active"
                                : "")">

                            <a class="page-link"
                               asp-action="Tasks"
                               asp-route-page="@pageNumber"
                               asp-route-search="@Model.Search"
                               asp-route-ownerId="@Model.OwnerId"
                               asp-route-projectId="@Model.ProjectId"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-priority="@Model.Priority"
                               asp-route-status="@Model.Status"
                               asp-route-sortBy="@Model.SortBy">

                                @pageNumber

                            </a>

                        </li>
                    }


                    @if (Model.Page < Model.TotalPages)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Tasks"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-ownerId="@Model.OwnerId"
                               asp-route-projectId="@Model.ProjectId"
                               asp-route-categoryId="@Model.CategoryId"
                               asp-route-priority="@Model.Priority"
                               asp-route-status="@Model.Status"
                               asp-route-sortBy="@Model.SortBy">

                                ›

                            </a>

                        </li>
                    }

                </ul>
            }

        </div>
    }

</div>


@section Scripts
{
    <script>

        const selectAllTasks =
            document.getElementById(
                "selectAllTasks");

        const taskCheckboxes =
            document.querySelectorAll(
                ".task-checkbox");

        const bulkActionSelect =
            document.getElementById(
                "bulkTaskActionSelect");

        const bulkActionButton =
            document.getElementById(
                "bulkTaskActionButton");

        const bulkTaskActionForm =
            document.getElementById(
                "bulkTaskActionForm");

        const selectedIdsContainer =
            document.getElementById(
                "bulkTaskSelectedIds");

        const taskSelectionCount =
            document.getElementById(
                "taskSelectionCount");


        function getCheckedTasks() {

            return document.querySelectorAll(
                ".task-checkbox:checked"
            );

        }


        function updateTaskSelection() {

            const checkedTasks =
                getCheckedTasks();

            const checkedCount =
                checkedTasks.length;


            if (taskSelectionCount) {

                taskSelectionCount.textContent =
                    checkedCount === 0
                        ? "No tasks selected"
                        : `${checkedCount} task${checkedCount === 1 ? "" : "s"} selected`;

            }


            if (bulkActionButton) {

                bulkActionButton.disabled =
                    checkedCount === 0 ||
                    !bulkActionSelect?.value;

            }


            if (selectAllTasks) {

                selectAllTasks.checked =
                    taskCheckboxes.length > 0 &&
                    checkedCount === taskCheckboxes.length;

                selectAllTasks.indeterminate =
                    checkedCount > 0 &&
                    checkedCount < taskCheckboxes.length;

            }

        }


        if (selectAllTasks) {

            selectAllTasks.addEventListener(
                "change",
                function() {

                    taskCheckboxes.forEach(
                        checkbox => {

                            checkbox.checked =
                                selectAllTasks.checked;

                        });

                    updateTaskSelection();

                });

        }


        taskCheckboxes.forEach(
            checkbox => {

                checkbox.addEventListener(
                    "change",
                    updateTaskSelection);

            });


        if (bulkActionSelect) {

            bulkActionSelect.addEventListener(
                "change",
                updateTaskSelection);

        }


        if (bulkTaskActionForm) {

            bulkTaskActionForm.addEventListener(
                "submit",
                function(event) {

                    const checkedTasks =
                        getCheckedTasks();


                    if (checkedTasks.length === 0) {

                        event.preventDefault();
                        return;

                    }


                    if (!bulkActionSelect.value) {

                        event.preventDefault();
                        return;

                    }


                    if (
                        bulkActionSelect.value ===
                        "delete"
                    ) {

                        const confirmed =
                            confirm(
                                `Delete ${checkedTasks.length} selected task${checkedTasks.length === 1 ? "" : "s"}?`
                            );

                        if (!confirmed) {

                            event.preventDefault();
                            return;

                        }

                    }


                    selectedIdsContainer.innerHTML =
                        "";


                    checkedTasks.forEach(
                        checkbox => {

                            const hiddenInput =
                                document.createElement(
                                    "input"
                                );

                            hiddenInput.type =
                                "hidden";

                            hiddenInput.name =
                                "selectedTaskIds";

                            hiddenInput.value =
                                checkbox.value;

                            selectedIdsContainer.appendChild(
                                hiddenInput
                            );

                        });

                });

        }


        updateTaskSelection();

    </script>
}