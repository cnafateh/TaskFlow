@model TaskFlow.Web.ViewModels.Admin.AdminTaskIndexViewModel

@{
    ViewData["Title"] = "Manage Tasks";
}


<div class="page-header">

    <div>

        <h1 class="page-title">
            Manage Tasks
        </h1>

        <p class="page-subtitle">
            @Model.TotalCount task(s) across all users
        </p>

    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary">

        Back to Dashboard

    </a>

</div>


<div class="app-card filter-card">

    <form asp-controller="Admin"
          asp-action="Tasks"
          method="get">

        <div class="filter-grid">


            <div>

                <label class="form-label">
                    Search
                </label>

                <input asp-for="Search"
                       class="form-control"
                       placeholder="Task, project, category or user..." />

            </div>


            <div>

                <label class="form-label">
                    Owner
                </label>

                <select asp-for="OwnerId"
                        class="form-select">

                    <option value="">
                        All Users
                    </option>

                    @foreach (var owner in Model.Owners)
                    {
                        <option value="@owner.Id">
                            @owner.Email
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Project
                </label>

                <select asp-for="ProjectId"
                        class="form-select">

                    <option value="">
                        All Projects
                    </option>

                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project.Id">
                            @project.Name — @(project.User?.Email ?? "Unknown")
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Category
                </label>

                <select asp-for="CategoryId"
                        class="form-select">

                    <option value="">
                        All Categories
                    </option>

                    @foreach (var category in Model.Categories)
                    {
                        <option value="@category.Id">
                            @category.Name — @(category.User?.Email ?? "Unknown")
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Priority
                </label>

                <select asp-for="Priority"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskPriority>()"
                        class="form-select">

                    <option value="">
                        All Priorities
                    </option>

                </select>

            </div>


            <div>

                <label class="form-label">
                    Status
                </label>

                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<TaskFlow.Web.Models.Enums.TaskStatus>()"
                        class="form-select">

                    <option value="">
                        All Statuses
                    </option>

                </select>

            </div>


            <div>

                <label class="form-label">
                    Sort
                </label>

                <select asp-for="SortBy"
                        class="form-select">

                    <option value="createdAtDesc">
                        Created - Newest
                    </option>

                    <option value="createdAt">
                        Created - Oldest
                    </option>

                    <option value="dueDate">
                        Due Date - Earliest
                    </option>

                    <option value="dueDateDesc">
                        Due Date - Latest
                    </option>

                    <option value="title">
                        Title A-Z
                    </option>

                    <option value="titleDesc">
                        Title Z-A
                    </option>

                </select>

            </div>

        </div>


        <div class="d-flex gap-2 mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Apply Filters
            </button>

            <a asp-controller="Admin"
               asp-action="Tasks"
               class="btn btn-outline-secondary">
                Reset
            </a>

        </div>

    </form>

</div>


@if (Model.Tasks.Count == 0)
{
    <div class="empty-state">

        <h3>
            No tasks found
        </h3>

        <p class="text-muted mb-0">
            Try changing the current filters.
        </p>

    </div>
}
else
{
    <div class="d-flex justify-content-between
        align-items-center mb-3">

        <div class="text-muted small">

            Select tasks to perform bulk actions.

        </div>


        <form id="bulkDeleteForm"
              asp-controller="Admin"
              asp-action="BulkDeleteTasks"
              method="post"
              onsubmit="return confirm(
            'Delete all selected tasks?');">

            <button type="submit"
                    class="btn btn-danger btn-sm">

                Delete Selected

            </button>

        </form>

    </div>


    <div class="app-card table-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th style="width: 45px;">

                            <input id="selectAllTasks"
                                   type="checkbox"
                                   class="form-check-input"
                                   aria-label="Select all tasks" />

                        </th>

                        <th>Task</th>

                        <th>Owner</th>

                        <th>Project</th>

                        <th>Category</th>

                        <th>Priority</th>

                        <th>Status</th>

                        <th>Due</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (var task in Model.Tasks)
                    {
                        <tr>

                            <td>

                                <input type="checkbox"
                                       name="selectedTaskIds"
                                       value="@task.Id"
                                       form="bulkDeleteForm"
                                       class="form-check-input task-checkbox"
                                       aria-label="Select @task.Title" />

                            </td>


                            <td>

                                <div class="fw-semibold">
                                    @task.Title
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                        task.Description))
                                {
                                    <div class="text-muted small">
                                        @task.Description
                                    </div>
                                }

                            </td>


                            <td>

                                @(task.Project?.User?.Email
                                    ?? "Unknown")

                            </td>


                            <td>
                                @task.Project?.Name
                            </td>


                            <td>
                                @task.Category?.Name
                            </td>


                            <td>

                                @if (
                                    task.Priority ==
                                    TaskFlow.Web.Models.Enums.TaskPriority.High)
                                {
                                    <span class="badge text-bg-danger">
                                        High
                                    </span>
                                }
                                else if (
                                    task.Priority ==
                                    TaskFlow.Web.Models.Enums.TaskPriority.Medium)
                                {
                                    <span class="badge text-bg-warning">
                                        Medium
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Low
                                    </span>
                                }

                            </td>


                            <td>

                                @if (
                                    task.Status ==
                                    TaskFlow.Web.Models.Enums.TaskStatus.Done)
                                {
                                    <span class="badge text-bg-success">
                                        Done
                                    </span>
                                }
                                else if (
                                    task.Status ==
                                    TaskFlow.Web.Models.Enums.TaskStatus.InProgress)
                                {
                                    <span class="badge text-bg-primary">
                                        In Progress
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        Todo
                                    </span>
                                }

                            </td>


                            <td class="text-nowrap">

                                @task.DueDate.ToString(
                                    "yyyy-MM-dd")

                            </td>


                            <td class="text-end">

                                <form asp-controller="Admin"
                                      asp-action="DeleteTask"
                                      asp-route-id="@task.Id"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm(
                                    'Delete this task?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">

                                        Delete

                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@if (Model.TotalPages > 1)
{
    <nav aria-label="Admin task pagination">

        <ul class="pagination justify-content-center">

            @if (Model.Page > 1)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Tasks"
                       asp-route-page="@(Model.Page - 1)"
                       asp-route-search="@Model.Search"
                       asp-route-ownerId="@Model.OwnerId"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-priority="@Model.Priority"
                       asp-route-status="@Model.Status"
                       asp-route-sortBy="@Model.SortBy">

                        Previous

                    </a>

                </li>
            }


            @for (
                int pageNumber = 1;
                pageNumber <= Model.TotalPages;
                pageNumber++)
            {
                <li class="page-item
                    @(pageNumber == Model.Page
                        ? "active"
                        : "")">

                    <a class="page-link"
                       asp-action="Tasks"
                       asp-route-page="@pageNumber"
                       asp-route-search="@Model.Search"
                       asp-route-ownerId="@Model.OwnerId"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-priority="@Model.Priority"
                       asp-route-status="@Model.Status"
                       asp-route-sortBy="@Model.SortBy">

                        @pageNumber

                    </a>

                </li>
            }


            @if (Model.Page < Model.TotalPages)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Tasks"
                       asp-route-page="@(Model.Page + 1)"
                       asp-route-search="@Model.Search"
                       asp-route-ownerId="@Model.OwnerId"
                       asp-route-projectId="@Model.ProjectId"
                       asp-route-categoryId="@Model.CategoryId"
                       asp-route-priority="@Model.Priority"
                       asp-route-status="@Model.Status"
                       asp-route-sortBy="@Model.SortBy">

                        Next

                    </a>

                </li>
            }

        </ul>

    </nav>
}


@section Scripts
{
    <script>
        const selectAll =
            document.getElementById("selectAllTasks");

        const taskCheckboxes =
            document.querySelectorAll(".task-checkbox");


        if (selectAll) {

            selectAll.addEventListener(
                "change",
                function() {

                    taskCheckboxes.forEach(
                        checkbox => {

                            checkbox.checked =
                                selectAll.checked;

                        });

                });


            taskCheckboxes.forEach(
                checkbox => {

                    checkbox.addEventListener(
                        "change",
                        function() {

                            const checkedCount =
                                document.querySelectorAll(
                                    ".task-checkbox:checked"
                                ).length;

                            selectAll.checked =
                                checkedCount ===
                                taskCheckboxes.length;

                            selectAll.indeterminate =
                                checkedCount > 0 &&
                                checkedCount <
                                taskCheckboxes.length;

                        });

                });

        }
    </script>
}