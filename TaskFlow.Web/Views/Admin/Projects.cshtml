@model TaskFlow.Web.ViewModels.Admin.AdminProjectIndexViewModel

@{
    ViewData["Title"] = "Projects";
}

<div class="admin-page-header">

    <div class="admin-page-heading">

        <div class="d-flex align-items-center flex-wrap">

            <h1 class="admin-page-title">
                Projects
            </h1>

            <span class="admin-count">
                @Model.TotalCount
            </span>

        </div>

        <p class="admin-page-description">
            Review and manage projects across all TaskFlow accounts.
        </p>

    </div>

</div>


<div class="admin-filter-panel">

    <form asp-controller="Admin"
          asp-action="Projects"
          method="get">

        <div class="admin-filter-grid">

            <div>

                <label class="form-label">
                    Search
                </label>

                <div class="admin-search-wrap">

                    <svg class="admin-search-icon"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">

                        <circle cx="11"
                                cy="11"
                                r="7">
                        </circle>

                        <path d="m20 20-3.5-3.5">
                        </path>

                    </svg>

                    <input asp-for="Search"
                           class="form-control admin-search-input"
                           placeholder="Project, description or owner..." />

                </div>

            </div>


            <div>

                <label class="form-label">
                    Owner
                </label>

                <select asp-for="OwnerId"
                        class="form-select">

                    <option value="">
                        All users
                    </option>

                    @foreach (var owner in Model.Owners)
                    {
                        <option value="@owner.Id">
                            @owner.Email
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Sort
                </label>

                <select asp-for="SortBy"
                        class="form-select">

                    <option value="createdAtDesc">
                        Newest first
                    </option>

                    <option value="createdAt">
                        Oldest first
                    </option>

                    <option value="name">
                        Name A–Z
                    </option>

                    <option value="nameDesc">
                        Name Z–A
                    </option>

                </select>

            </div>


            <div class="admin-filter-actions">

                <button type="submit"
                        class="btn btn-primary">

                    Apply filters

                </button>

                <a asp-action="Projects"
                   class="btn btn-outline-secondary">

                    Reset

                </a>

            </div>

        </div>

    </form>

</div>


<div class="admin-data-panel">


    <div class="admin-data-toolbar">

        <div class="admin-data-toolbar-left">

            <span id="projectSelectionCount"
                  class="admin-selected-count">

                No projects selected

            </span>

        </div>


        <div class="admin-data-toolbar-right">

            <form id="bulkProjectDeleteForm"
                  asp-controller="Admin"
                  asp-action="BulkDeleteProjects"
                  method="post"
                  onsubmit="return confirm(
                      'Deleting selected projects will also delete their tasks. Continue?');">

                <button id="bulkProjectDeleteButton"
                        type="submit"
                        class="btn btn-sm btn-outline-danger admin-bulk-button"
                        disabled>

                    Delete selected

                </button>

            </form>

        </div>

    </div>


    @if (Model.Projects.Count == 0)
    {
        <div class="admin-empty">

            <div class="admin-empty-icon">
                P
            </div>

            <div class="admin-empty-title">
                No projects found
            </div>

            <p class="admin-empty-text">
                Try changing the current search or filters.
            </p>

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="admin-table">

                <thead>

                    <tr>

                        <th style="width: 44px;">

                            <input id="selectAllProjects"
                                   type="checkbox"
                                   class="form-check-input"
                                   aria-label="Select all projects" />

                        </th>

                        <th>Project</th>

                        <th>Owner</th>

                        <th>Tasks</th>

                        <th>Created</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                @foreach (var project in Model.Projects)
                {
                    string ownerEmail =
                        string.IsNullOrWhiteSpace(project.OwnerEmail)
                            ? "Unknown"
                            : project.OwnerEmail;

                    string ownerInitial =
                        ownerEmail.Length > 0
                            ? ownerEmail[..1].ToUpper()
                            : "?";

                    <tr>

                        <td>

                            <input type="checkbox"
                                   name="selectedProjectIds"
                                   value="@project.Id"
                                   form="bulkProjectDeleteForm"
                                   class="form-check-input project-checkbox"
                                   aria-label="Select @project.Name" />

                        </td>


                        <td>

                            <div class="admin-table-title">
                                @project.Name
                            </div>

                            @if (!string.IsNullOrWhiteSpace(
                                    project.Description))
                            {
                                <div class="admin-table-subtitle">
                                    @project.Description
                                </div>
                            }

                        </td>


                        <td>

                            <div class="admin-user-cell">

                                <div class="admin-user-avatar">
                                    @ownerInitial
                                </div>

                                <div class="admin-user-email">
                                    @ownerEmail
                                </div>

                            </div>

                        </td>


                        <td>

                            @if (project.TaskCount > 0)
                            {
                                <span class="admin-badge admin-badge-primary">
                                    @project.TaskCount
                                    task@(project.TaskCount == 1 ? "" : "s")
                                </span>
                            }
                            else
                            {
                                <span class="admin-badge admin-badge-neutral">
                                    Empty
                                </span>
                            }

                        </td>


                        <td>

                            <span class="admin-table-muted">
                                @project.CreatedAt.ToString("MMM dd, yyyy")
                            </span>

                        </td>


                        <td>

                            <div class="admin-table-actions">

                                <form asp-controller="Admin"
                                      asp-action="DeleteProject"
                                      asp-route-id="@project.Id"
                                      method="post"
                                      onsubmit="return confirm(
                                          'Deleting this project will also delete its tasks. Continue?');">

                                    <button type="submit"
                                            class="admin-icon-button admin-icon-button-danger">

                                        Delete

                                    </button>

                                </form>

                            </div>

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>


        <div class="admin-table-footer">

            <div class="admin-pagination-info">

                Page @Model.Page of
                @(Model.TotalPages == 0 ? 1 : Model.TotalPages)

                · @Model.TotalCount total projects

            </div>


            @if (Model.TotalPages > 1)
            {
                <ul class="pagination">

                    @if (Model.Page > 1)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Projects"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-search="@Model.Search"
                               asp-route-ownerId="@Model.OwnerId"
                               asp-route-sortBy="@Model.SortBy">

                                ‹

                            </a>

                        </li>
                    }


                    @for (
                        int pageNumber = 1;
                        pageNumber <= Model.TotalPages;
                        pageNumber++)
                    {
                        <li class="page-item
                                   @(pageNumber == Model.Page
                                       ? "active"
                                       : "")">

                            <a class="page-link"
                               asp-action="Projects"
                               asp-route-page="@pageNumber"
                               asp-route-search="@Model.Search"
                               asp-route-ownerId="@Model.OwnerId"
                               asp-route-sortBy="@Model.SortBy">

                                @pageNumber

                            </a>

                        </li>
                    }


                    @if (Model.Page < Model.TotalPages)
                    {
                        <li class="page-item">

                            <a class="page-link"
                               asp-action="Projects"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-search="@Model.Search"
                               asp-route-ownerId="@Model.OwnerId"
                               asp-route-sortBy="@Model.SortBy">

                                ›

                            </a>

                        </li>
                    }

                </ul>
            }

        </div>
    }

</div>


@section Scripts
{
    <script>

        const selectAllProjects =
            document.getElementById(
                "selectAllProjects");

        const projectCheckboxes =
            document.querySelectorAll(
                ".project-checkbox");

        const bulkProjectButton =
            document.getElementById(
                "bulkProjectDeleteButton");

        const projectSelectionCount =
            document.getElementById(
                "projectSelectionCount");


        function updateProjectSelection() {

            const checked =
                document.querySelectorAll(
                    ".project-checkbox:checked"
                ).length;


            if (projectSelectionCount) {

                projectSelectionCount.textContent =
                    checked === 0
                        ? "No projects selected"
                        : `${checked} project${checked === 1 ? "" : "s"} selected`;

            }


            if (bulkProjectButton) {

                bulkProjectButton.disabled =
                    checked === 0;

            }


            if (selectAllProjects) {

                selectAllProjects.checked =
                    projectCheckboxes.length > 0 &&
                    checked === projectCheckboxes.length;

                selectAllProjects.indeterminate =
                    checked > 0 &&
                    checked < projectCheckboxes.length;

            }

        }


        if (selectAllProjects) {

            selectAllProjects.addEventListener(
                "change",
                function () {

                    projectCheckboxes.forEach(
                        checkbox => {

                            checkbox.checked =
                                selectAllProjects.checked;

                        });

                    updateProjectSelection();

                });

        }


        projectCheckboxes.forEach(
            checkbox => {

                checkbox.addEventListener(
                    "change",
                    updateProjectSelection);

            });


        updateProjectSelection();

    </script>
}