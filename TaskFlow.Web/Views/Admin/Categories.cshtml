@model TaskFlow.Web.ViewModels.Admin.AdminCategoryIndexViewModel

@{
    ViewData["Title"] = "Manage Categories";
}


<div class="page-header">

    <div>

        <h1 class="page-title">
            Manage Categories
        </h1>

        <p class="page-subtitle">
            @Model.TotalCount category(s) across all users
        </p>

    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>

</div>


<div class="app-card filter-card">

    <form asp-action="Categories"
          method="get">

        <div class="filter-grid">

            <div>

                <label class="form-label">
                    Search
                </label>

                <input asp-for="Search"
                       class="form-control"
                       placeholder="Category or owner..." />

            </div>


            <div>

                <label class="form-label">
                    Owner
                </label>

                <select asp-for="OwnerId"
                        class="form-select">

                    <option value="">
                        All Users
                    </option>

                    @foreach (var owner in Model.Owners)
                    {
                        <option value="@owner.Id">
                            @owner.Email
                        </option>
                    }

                </select>

            </div>


            <div>

                <label class="form-label">
                    Sort
                </label>

                <select asp-for="SortBy"
                        class="form-select">

                    <option value="name">
                        Name A-Z
                    </option>

                    <option value="nameDesc">
                        Name Z-A
                    </option>

                </select>

            </div>

        </div>


        <div class="d-flex gap-2 mt-3">

            <button type="submit"
                    class="btn btn-primary">
                Apply Filters
            </button>

            <a asp-action="Categories"
               class="btn btn-outline-secondary">
                Reset
            </a>

        </div>

    </form>

</div>


@if (Model.Categories.Count == 0)
{
    <div class="empty-state">
        <h3>No categories found</h3>
    </div>
}
else
{
    <form id="bulkCategoryDeleteForm"
          asp-action="BulkDeleteCategories"
          method="post"
          onsubmit="return confirm('Delete the selected unused categories?');">

        <div class="d-flex justify-content-end mb-3">

            <button type="submit"
                    class="btn btn-danger btn-sm">
                Delete Selected
            </button>

        </div>

    </form>


    <div class="app-card table-card">

        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th style="width:45px;">
                            <input id="selectAllCategories"
                                   type="checkbox"
                                   class="form-check-input" />
                        </th>

                        <th>Category</th>

                        <th>Owner</th>

                        <th>Used By Tasks</th>

                        <th class="text-end">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @foreach (
                        var category
                        in Model.Categories)
                    {
                        <tr>

                            <td>

                                <input type="checkbox"
                                       class="form-check-input category-checkbox"
                                       name="selectedCategoryIds"
                                       value="@category.Id"
                                       form="bulkCategoryDeleteForm" />

                            </td>


                            <td class="fw-semibold">
                                @category.Name
                            </td>


                            <td>
                                @category.OwnerEmail
                            </td>


                            <td>
                                @category.TaskCount
                            </td>


                            <td class="text-end">

                                @if (category.TaskCount == 0)
                                {
                                    <form asp-action="DeleteCategory"
                                          asp-route-id="@category.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Delete this category?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger">

                                            Delete

                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        In use
                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}


@if (Model.TotalPages > 1)
{
    <nav>

        <ul class="pagination justify-content-center">

            @for (
                int pageNumber = 1;
                pageNumber <= Model.TotalPages;
                pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.Page ? "active" : "")">

                    <a class="page-link"
                       asp-action="Categories"
                       asp-route-page="@pageNumber"
                       asp-route-search="@Model.Search"
                       asp-route-ownerId="@Model.OwnerId"
                       asp-route-sortBy="@Model.SortBy">

                        @pageNumber

                    </a>

                </li>
            }

        </ul>

    </nav>
}


@section Scripts
{
    <script>
        const selectAllCategories =
            document.getElementById(
                "selectAllCategories");

        const categoryCheckboxes =
            document.querySelectorAll(
                ".category-checkbox");


        if (selectAllCategories) {

            selectAllCategories.addEventListener(
                "change",
                function() {

                    categoryCheckboxes.forEach(
                        checkbox =>
                            checkbox.checked =
                            selectAllCategories.checked);

                });
        }
    </script>
}